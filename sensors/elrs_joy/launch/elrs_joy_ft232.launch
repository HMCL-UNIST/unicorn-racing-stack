<launch>
    <!-- ELRS Joy node — FT232RL variant.
         FT232RL hits 420000 baud exactly, so we run CRSF at the protocol's
         native rate with CRC-8 (poly 0xD5) validation enabled. This catches
         garbage frames born from connector noise / vibration transients with
         probability ~99.6%, removing the main path through which phantom
         buttons reached simple_mux on the CP2102 setup.

         To compare CRC ON vs OFF on the same hardware:
           roslaunch elrs_joy elrs_joy_ft232.launch enable_crc:=true
           roslaunch elrs_joy elrs_joy_ft232.launch enable_crc:=false
         Then watch:
           rostopic echo /elrs_joy_node/debug_stats
           (or the periodic 10s rosout line) -->
    <arg name="enable_crc"     default="true"/>
    <arg name="port"           default="/dev/ELRS_FT232"/>
    <arg name="baud_rate"      default="420000"/>
    <arg name="debug_stats_hz" default="1.0"/>
    <!-- RB latency-zero safety guard (predicates 1 + 4).
         rb_stability_frames: PRE-window length in frames @100Hz for the
           "no dip in the released hold band" predicate. 10 = 0.1s. Tighter
           than the user's reaction time (~200ms) so a noise event followed
           by a real press is NOT suppressed even at 1s separation.
         rb_released_min:     RB raw threshold above which the channel counts
           as "in the released band" for stability (CH6 mapping, 992 = the
           CRSF mid-point that the noise-free hold sits above).
         rb_jerk_max:         max |delta| on CH0/CH2 (steer/throttle) between
           the rising tick and the previous valid frame. 200 ≈ ±11% of the
           0..1811 raw scale. User does not move sticks while pressing RB,
           so a genuine press always has small jerk; a garbage frame
           randomizes all 16 channels at once so jerk is large. -->
    <arg name="rb_stability_frames" default="10"/>
    <arg name="rb_released_min"     default="992"/>
    <arg name="rb_jerk_max"         default="200"/>

    <node name="elrs_joy_node" pkg="elrs_joy" type="elrs_joy_ft232_node.py" output="screen">
        <!-- Serial port settings (FT232RL @ /dev/ELRS_FT232, full CRSF baud) -->
        <param name="port"           value="$(arg port)"/>
        <param name="baud_rate"      value="$(arg baud_rate)"/>
        <param name="enable_crc"     value="$(arg enable_crc)"/>
        <param name="debug_stats_hz" value="$(arg debug_stats_hz)"/>
        <param name="rb_stability_frames" value="$(arg rb_stability_frames)"/>
        <param name="rb_released_min"     value="$(arg rb_released_min)"/>
        <param name="rb_jerk_max"         value="$(arg rb_jerk_max)"/>

        <!-- Publish rate (Hz) -->
        <param name="publish_rate" value="100"/>

        <!-- Xbox-compatible Joy message: 8 axes, 11 buttons -->
        <param name="num_axes" value="8"/>
        <param name="num_buttons" value="11"/>

        <!-- Axis mapping: joy_index -> CRSF channel -->
        <!-- axes[1]=Throttle(CH1), axes[3]=Steering(CH3) -->
        <rosparam param="axes_joy_indices">[1, 3]</rosparam>
        <rosparam param="axes_crsf_channels">[2, 0]</rosparam>
        <!-- Axis sign: [throttle, steering], -1.0 to invert -->
        <rosparam param="axes_invert">[1.0, -1.0]</rosparam>
        <!-- Per-axis CRSF calibration (carried over from legacy elrs_joy.launch).
             Index order matches axes_crsf_channels: [throttle(CH2), steering(CH0)].
             throttle: 174 / 1007 / 1811   (full range, mid offset from 992)
             steering: 174 /  992 / 1773   (positive end short of 1811)
             Asymmetric normalize ensures ±1.0 hits both mechanical stops. -->
        <rosparam param="axes_cal_min">[174, 174]</rosparam>
        <rosparam param="axes_cal_mid">[1007, 992]</rosparam>
        <rosparam param="axes_cal_max">[1811, 1773]</rosparam>

        <!-- Button mapping: joy_index -> CRSF channel -->
        <!-- buttons[0]=A(CH7, latched, invert=1), buttons[4]=LB(CH5), buttons[5]=RB(CH6) -->
        <rosparam param="button_joy_indices">[0, 4, 5]</rosparam>
        <rosparam param="button_crsf_channels">[7, 5, 6]</rosparam>
        <rosparam param="button_invert">[1, 0, 0]</rosparam>

        <!-- Button threshold (CRSF value, below=pressed) -->
        <param name="button_threshold" value="992"/>

        <!-- Deadzone for axes (0.0 ~ 1.0) -->
        <param name="deadzone" value="0.05"/>

        <!-- Failsafe timeout (seconds) -->
        <param name="failsafe_timeout" value="0.5"/>

        <!-- LB 3-position safety guard (identical to legacy node) -->
        <param name="lb_pressed_max"     value="350"/>
        <param name="lb_idle_min"        value="700"/>
        <param name="lb_idle_max"        value="1300"/>
        <param name="lb_released_min"    value="1600"/>
        <param name="lb_debounce_frames" value="5"/>

        <!-- A button N-frame debounce (identical to legacy node) -->
        <param name="a_debounce_frames"  value="5"/>

        <param name="frame_id" value="elrs_joy"/>
    </node>
</launch>