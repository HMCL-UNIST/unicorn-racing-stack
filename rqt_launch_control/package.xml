<?xml version="1.0"?>
<package format="2">
  <name>rqt_launch_control</name>
  <version>0.1.0</version>
  <description>rqt plugin for live launch profile (i_cmd vs t) curve preview via dynamic_reconfigure</description>
  <maintainer email="unicornracing2020@gmail.com">UNICORN Racing</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>rqt_gui</exec_depend>
  <exec_depend>rqt_gui_py</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <rqt_gui plugin="${prefix}/plugin.xml"/>
  </export>
</package>
